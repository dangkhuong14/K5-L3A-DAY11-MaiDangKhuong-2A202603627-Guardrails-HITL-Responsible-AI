# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# =============================================================================
# BLUE (CP2–CP3) — LFM 3 1.7B (LOCKED), chọn Liquid trực tiếp hoặc OpenRouter
# =============================================================================
BLUE_TEAM_PROVIDER=liquid
LIQUID_API_KEY=your-liquid-api-key-here
# Model khóa cứng trong code; LIQUID_MODEL / BLUE_MODEL trong .env không có tác dụng.
# LIQUID_BASE_URL=https://api.liquid.ai/openai/v1
# API ID: Liquid = lfm3-1.7b; OpenRouter = liquid/lfm-3-1.7b:free.

# Đổi BLUE_TEAM_PROVIDER=openrouter để dùng lại đường OpenRouter của lab:
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# RED + RED ADVANCE (CP4) — chọn MỘT provider (cùng key/model cho cả hai agent)
# Model lab mặc định (điểm bắt buộc CP4): gpt-4o-mini | gemini-3.5-flash
# Model khó (tuỳ chọn khi săn bonus):       gpt-5.6-luna | gemini-3.8-flash
# =============================================================================
RED_TEAM_PROVIDER=openai
# RED_TEAM_PROVIDER=gemini
# RED_TEAM_PROVIDER=anthropic

# --- anthropic (API key từ Claude Console, dùng OpenAI-compatible endpoint) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# Nếu key không gắn workspace, đặt workspace ID theo Claude Console:
# ANTHROPIC_WORKSPACE_ID=your-workspace-id

# Red Advance còn chạy NVIDIA NeMo Guardrails (self check input/output) bằng CÙNG
# provider / model / key ở trên — không cần biến mới. Gemini đi qua endpoint
# OpenAI-compatible của Google AI Studio (dùng GOOGLE_API_KEY).
# Lab mặc định tắt anonymous usage stats của NeMo; muốn bật lại thì đặt =0:
# NEMO_GUARDRAILS_NO_USAGE_STATS=1

# --- openai ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-5.6-luna

# --- gemini ---
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash
